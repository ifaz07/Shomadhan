# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173        # comma-separate to allow several frontends
BACKEND_URL=http://localhost:5000
# TRUST_PROXY_HOPS=1                    # proxies in front of the API in production
# ALLOW_PREVIEW_ORIGINS=false           # true trusts every *.vercel.app / *.netlify.app origin

# ─── Database ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/shomadhan

# ─── Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ─
JWT_SECRET=
JWT_EXPIRE=7d
SESSION_SECRET=

# ─── Seed scripts (npm run seed:admin / seed:mayor); password min 12 chars ─
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAYOR_EMAIL=
MAYOR_PASSWORD=

# ─── Cloudinary ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Email and AI providers (optional) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# ─── Misc ────────────────────────────────────────────────────────────
# ENABLE_ESCALATION_CRON=true
# COOKIE_SECURE=
# COOKIE_SAME_SITE=
